# temporal_extractor configuration.
#
# Copy to .env (install.bat does this for you) and fill in the three required
# paths. Real environment variables override anything set here.
#
# Nothing is guessed from anything else: these are three independent locations
# and installing SeedVR2 does not imply they sit near each other.

# REQUIRED -- your SeedVR2 checkout (the folder containing src/ and configs_7b/).
SEEDVR2_REPO=

# REQUIRED -- the python.exe of the virtualenv that has torch installed.
# This is NOT the tool's own venv. The tool deliberately runs without torch so
# the restorer's dependency pins cannot constrain it.
SEEDVR2_PYTHON=

# REQUIRED -- the folder holding the DiT checkpoint and the VAE.
MODEL_DIR=

# OPTIONAL -- which checkpoints to load from MODEL_DIR. The defaults below are
# the filenames the common SeedVR2 release ships. Set these whenever yours
# differ, which is often: quantisation variants (fp16, fp8, int8, nvfp4 and
# whatever later releases add) all have different names, and files get renamed.
# `extract.bat doctor` lists what it actually finds in MODEL_DIR.
#DIT_MODEL=seedvr2_ema_7b_fp8_e4m3fn_mixed_block35_fp16.safetensors
#VAE_MODEL=ema_vae_fp16.safetensors
