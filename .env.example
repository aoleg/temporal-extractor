# temporal_extractor configuration.
#
# Copy to .env (install.bat does this for you) and set SEEDVR2_REPO.
# Real environment variables override anything set here.

# REQUIRED -- your SeedVR2 checkout (the folder containing src/ and configs_7b/).
SEEDVR2_REPO=

# Everything below is optional. By default it is derived from SEEDVR2_REPO,
# assuming the usual layout where the checkout, its virtualenv and the model
# folder are siblings under one root:
#
#     <root>/refs/seedvr2       SEEDVR2_REPO
#     <root>/.venv-seedvr2      SEEDVR2_PYTHON
#     <root>/models/seedvr2     MODEL_DIR
#
# Uncomment and set any that do not match your layout.

# The interpreter that has torch installed. This is NOT the tool's own venv --
# the tool runs without torch on purpose, so the restorer's dependency pins
# cannot constrain it.
#SEEDVR2_PYTHON=D:\seedvr2\.venv-seedvr2\Scripts\python.exe

# Folder holding the DiT checkpoint and the VAE.
#MODEL_DIR=D:\seedvr2\models\seedvr2

# Which checkpoints to load from MODEL_DIR.
#DIT_MODEL=seedvr2_ema_7b_fp8_e4m3fn_mixed_block35_fp16.safetensors
#VAE_MODEL=ema_vae_fp16.safetensors
